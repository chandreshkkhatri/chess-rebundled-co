{
  "name": "chess-rebundled",
  "version": "1.0.0",
  "private": true,
  "description": "Multiplayer voice-based chess memory game",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter frontend build && pnpm --filter backend build",
    "start": "pnpm --filter backend start",
    "test": "pnpm --filter backend test && pnpm --filter frontend test",
    "lint": "pnpm --filter frontend lint",
    "typecheck": "pnpm --filter backend exec tsc --noEmit && pnpm --filter frontend exec tsc --noEmit --incremental false",
    "deploy:backend": "./scripts/deploy-backend.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.0",
    "dotenv": "^17.2.3",
    "elevenlabs": "^1.59.0"
  }
}
