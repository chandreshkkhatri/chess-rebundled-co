# Environment
NODE_ENV=development

PORT=3001
HOST=0.0.0.0

# Frontend URL (used for CORS in production; dev mode allows all origins)
CLIENT_URL=http://localhost:3000

MONGODB_URI=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Redis URL for session persistence (optional - falls back to in-memory if not provided)
# Format: redis://[[username][:password]@][host][:port][/db-number]
REDIS_URL=