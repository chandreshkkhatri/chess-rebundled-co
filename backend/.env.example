# Native backend settings. See docs/CONFIGURATION.md.
# Compose overrides NODE_ENV, HOST, PORT, and the database URLs below.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Browser frontend origin for production HTTP CORS.
CLIENT_URL=http://localhost:3000

# Native local database; Compose uses its internal MongoDB by default.
MONGODB_URI=mongodb://localhost:27017/chess-rebundled

# Gemini Developer API by default; see the optional Vertex settings below.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Required for normal Firebase Admin startup, including guest practice.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the key quoted and use escaped newlines: "-----BEGIN PRIVATE KEY-----\n..."
FIREBASE_PRIVATE_KEY=

# Optional native Redis persistence; Compose supplies redis://redis:6379.
# Format: redis://[[username][:password]@][host][:port][/db-number]
REDIS_URL=

# Optional Vertex AI mode. An API key selects express mode; without a key,
# project/location and Firebase service-account credentials (or ADC) are used.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
# GOOGLE_APPLICATION_CREDENTIALS=/path/available/to/the/backend/credentials.json

# Optional narration utilities only; not used by the chess server.
# ELEVENLABS_API_KEY=
